import numpy as np
temperature = np.array([25.2, 26.1, 25.8, 27.3, 26.9, 28.1])
print("Minimum:", np.min(temperature))
print("Maximum:", np.max(temperature))
print("Average:", np.mean(temperature))
print("Standard Deviation:", np.std(temperature))

OUTPUT:-
Minimum: 25.2
Maximum: 28.1
Average: 26.566666666666663
Standard Deviation: 0.9723968097209885
